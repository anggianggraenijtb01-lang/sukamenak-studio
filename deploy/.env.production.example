# Copy to deploy/.env ON THE SERVER (one per environment) and fill in. Never commit the filled-in file.
# Variables not listed here keep the defaults from backend/.env.example.

# --- Deploy ----------------------------------------------------------------------------------
# staging | production (also the compose project name: sukamenak-staging / sukamenak-production)
DEPLOY_ENV=staging
# Public host name; Caddy requests the TLS certificate for it. DNS must already point at this server.
SITE_ADDRESS=staging.sukamenak.org
# Registry and tag of the images (the deploy workflow passes IMAGE_TAG=<commit sha>).
IMAGE_PREFIX=ghcr.io/<github-owner>
IMAGE_TAG=latest

# --- App -------------------------------------------------------------------------------------
PUBLIC_BASE_URL=https://staging.sukamenak.org
CORS_ORIGIN=https://staging.sukamenak.org
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta

# --- Secrets (generate fresh values per environment) -------------------------------------------
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_SIGNING_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A COPY OUTSIDE THE SERVER (password manager). Without it, the core prompts in every backup are unreadable.
CORE_PROMPT_KEY=

# --- Model providers (only the ones in use) ----------------------------------------------------
GEMINI_API_KEY=
ARK_API_KEY=
FAL_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Seed (first deploy only; unset afterwards) ------------------------------------------------
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
