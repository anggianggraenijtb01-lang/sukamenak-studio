# Base URL of the Sukamenak Studio API.
# Development: leave unset. The Vite dev server proxies /api to the backend (see vite.config.ts),
# so the httpOnly refresh cookie stays same-origin.
# Production: the API lives on its own host, for example https://api.example.org/api/v1.
# That origin must be listed in the backend CORS_ORIGIN (credentials are sent with every request).
# VITE_API_BASE_URL=/api/v1

# Dev only (read by vite.config.ts, not exposed to the browser): where the proxy forwards /api.
# VITE_DEV_API_TARGET=http://localhost:3000
