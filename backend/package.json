{
  "name": "sukamenak-studio-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Sukamenak Studio API - hidden core prompt engine, auth, catalog and (Phase B/C) generation pipeline and admin.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "retention": "tsx src/retention/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "seed": "tsx src/seed/index.ts",
    "create-admin": "tsx src/seed/createAdmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
