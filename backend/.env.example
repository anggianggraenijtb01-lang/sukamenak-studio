# Sukamenak Studio backend - environment reference.
# Copy to `.env` and fill in. Never commit `.env`. The server refuses to start when a required
# variable is missing or malformed (see src/config/env.ts).

# --- Runtime ---------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port the API listens on.
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Express "trust proxy" hop count (set to 1 behind one reverse proxy so rate limiting sees client IPs).
TRUST_PROXY=0
# IANA timezone used to decide what "today" means for the daily generation limit.
APP_TIMEZONE=Asia/Jakarta
# Public base URL of this API (used to build absolute asset URLs). Optional; defaults to http://localhost:PORT.
# PUBLIC_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------------------------
# PostgreSQL connection string. docker-compose maps postgres to host port 5433.
DATABASE_URL=postgres://sukamenak:sukamenak@localhost:5433/sukamenak
# Database used by `npm test`. Its name MUST end in `_test`; tests TRUNCATE every table.
DATABASE_URL_TEST=postgres://sukamenak:sukamenak@localhost:5433/sukamenak_test

# --- Redis / queue ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# bullmq = jobs run in the worker process (production). inline = jobs run inside the API process (dev/test).
QUEUE_DRIVER=inline
# BullMQ queue name (change it to run several environments against one Redis).
QUEUE_NAME=generations
# Jobs the worker processes in parallel.
WORKER_CONCURRENCY=2
# Hard limit for one generation (all stages). Exceeding it fails the job with JOB_TIMEOUT.
JOB_TIMEOUT_MS=120000
# BullMQ attempts per job (1 + retries) and the exponential backoff base. Only transient provider errors
# (timeout, 429, 5xx, network) are retried; the inline driver never retries.
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=2000
# New generations a user may start per minute (RATE_LIMIT_EXCEEDED). The daily limit lives in app_settings.
GENERATION_RATE_LIMIT_PER_MINUTE=10

# --- Auth ------------------------------------------------------------------------------------
# HS256 secrets, at least 32 characters, must differ from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (12 in production; tests use 4).
BCRYPT_COST=12
# Set the refresh cookie `Secure` flag. Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=false
# How long (ms) requireAuth may cache a user lookup. 0 disables the cache.
AUTH_USER_CACHE_TTL_MS=5000

# --- Core prompt encryption ------------------------------------------------------------------
# AES-256-GCM key protecting core prompts (and, in Phase B, final prompts) at rest.
# Must be 32 random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored core prompt unreadable; rotating it needs a re-encrypt migration.
CORE_PROMPT_KEY=

# --- Storage ---------------------------------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR (relative paths resolve against backend/), served by
# GET /api/v1/files/:key?token=... with a short-lived HMAC token. s3 = S3-compatible bucket
# (MinIO in dev, R2/S3 in prod); clients then get presigned bucket URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# HMAC secret for signed file URLs (local driver), at least 32 characters. Required in production;
# in development it is derived from JWT_ACCESS_SECRET when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FILE_SIGNING_SECRET=
# Lifetime of a signed file URL, in seconds.
FILE_URL_TTL_SECONDS=900
# Stored (non-deleted) reference images one user may keep.
MAX_REFERENCES_PER_USER=50
# Reference uploads per user per minute.
REFERENCE_UPLOAD_RATE_LIMIT_PER_MINUTE=20
# Used when STORAGE_DRIVER=s3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sukamenak
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- HTTP ------------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (credentials are allowed for these only).
CORS_ORIGIN=http://localhost:5173
# Requests per minute per IP for the whole API, and for /auth/login + /auth/register.
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=20
# Per-user limit for POST /prompts/improve (it may call a paid model).
IMPROVE_RATE_LIMIT_PER_MINUTE=10
# Per admin: model test calls (POST /admin/models/:id/test may call a paid API) and core prompt test renders.
ADMIN_TEST_RATE_LIMIT_PER_MINUTE=10
# Model base_url may not point at loopback/private/link-local addresses unless this is true
# (only for a private inference node you control). Provider key variables must be one of
# DEEPSEEK_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY, FAL_KEY, ARK_API_KEY or start with PROVIDER_KEY_.
ALLOW_PRIVATE_PROVIDER_HOSTS=false

# --- Retention -------------------------------------------------------------------------------
# Daily job (worker process, or the API when QUEUE_DRIVER=inline; also `npm run retention`):
# deletes expired human-model reference photos and wipes prompt/remarks/slot values of old generations.
# 0 disables the schedule.
RETENTION_INTERVAL_MINUTES=1440
RETENTION_GENERATION_DAYS=90
RETENTION_HUMAN_REFERENCE_DAYS=7

# --- Model provider keys ---------------------------------------------------------------------
# model_configs.api_key_env stores only the NAME of one of these variables, never the key itself.
# A provider row is only used when its variable is set (the built-in `mock` provider needs none).
# Leave unused ones empty. Adapters: openai_compat (OPENAI_API_KEY, DEEPSEEK_API_KEY, ARK_API_KEY),
# gemini (GEMINI_API_KEY), fal (FAL_KEY).
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
ARK_API_KEY=

# --- Seed / CLI ------------------------------------------------------------------------------
# `npm run seed` creates 2 admins + 1 demo creator. If a password is unset, a random one is
# generated and printed to stdout exactly once (it is never written to the logger).
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
# `npm run create-admin -- --email you@example.com --name "Your Name"` reads the password from here.
# ADMIN_PASSWORD=
